CHRONOFACT_ENV=development            # production = strict secrets, docs off, reset off
LOG_LEVEL=INFO
# Accounts (no built-in defaults). Passwords >= 12 chars. If omitted in development a one-time password is printed.
CHRONOFACT_USER=examiner
CHRONOFACT_PASSWORD=
# CHRONOFACT_ANALYST_USER=analyst
# CHRONOFACT_ANALYST_PASSWORD=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
# Demo only (enables public demo accounts examiner / analyst). Refused when CHRONOFACT_ENV=production.
CHRONOFACT_DEMO_MODE=false
MAX_UPLOAD_MB=50
CHRONOFACT_ALLOW_RESET=true
# CORS_ORIGINS=https://your-frontend.example
# CHRONOFACT_ASSUMED_CHAT_TZ=+05:30
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
